{
    "name": "grocadex",
    "version": "1.0.1",
    "private": true,
    "description": "A React Native mobile app to track grocery expiry dates and expenses.",
    "keywords": [
        "expo",
        "gluestack",
        "nativewind",
        "postgresql",
        "prisma",
        "react native",
        "tanstack",
        "zustand"
    ],
    "license": "MIT",
    "author": "Visakan Kirubakaran",
    "main": "expo-router/entry",
    "scripts": {
        "start": "expo start",
        "dev": "concurrently \"npm start\" \"cd api && npm run dev\"",
        "lint": "oxlint",
        "format": "oxfmt --write",
        "format:check": "oxfmt --check",
        "typecheck": "tsc --noEmit --pretty false",
        "check": "pnpm run format:check && pnpm run lint && tsc --noEmit --pretty false",
        "prepare": "lefthook install",
        "reset-project": "node ./scripts/reset-project.js",
        "android": "expo start --android",
        "ios": "expo start --ios",
        "web": "expo start --web",
        "test": "jest --watchAll"
    },
    "dependencies": {
        "@expo/html-elements": "^0.4.3",
        "@expo/vector-icons": "^14.1.0",
        "@gluestack-ui/actionsheet": "^0.2.53",
        "@gluestack-ui/alert-dialog": "^0.1.38",
        "@gluestack-ui/button": "^1.0.14",
        "@gluestack-ui/divider": "^0.1.10",
        "@gluestack-ui/fab": "^0.1.28",
        "@gluestack-ui/form-control": "^0.1.19",
        "@gluestack-ui/icon": "^0.1.27",
        "@gluestack-ui/input": "^0.1.38",
        "@gluestack-ui/link": "^0.1.29",
        "@gluestack-ui/modal": "^0.1.41",
        "@gluestack-ui/nativewind-utils": "^1.0.28",
        "@gluestack-ui/overlay": "^0.1.22",
        "@gluestack-ui/select": "^0.1.31",
        "@gluestack-ui/spinner": "^0.1.15",
        "@gluestack-ui/toast": "^1.0.9",
        "@legendapp/motion": "^2.5.3",
        "@react-navigation/bottom-tabs": "^7.18.18",
        "@react-navigation/drawer": "^7.13.10",
        "@react-navigation/native": "^7.3.18",
        "@react-spring/web": "^9.7.5",
        "@reduxjs/toolkit": "^2.12.0",
        "@rn-primitives/slot": "^1.5.2",
        "@rn-primitives/types": "^1.5.2",
        "@shopify/flash-list": "1.7.3",
        "@shopify/react-native-skia": "1.5.0",
        "@tanstack/react-query": "^5.102.8",
        "axios": "^1.20.0",
        "babel-plugin-module-resolver": "^5.0.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "expo": "~52.0.49",
        "expo-blur": "~14.0.3",
        "expo-build-properties": "~0.13.3",
        "expo-constants": "~17.0.8",
        "expo-dev-client": "~5.0.20",
        "expo-font": "~13.0.4",
        "expo-haptics": "~14.0.1",
        "expo-linking": "~7.0.5",
        "expo-router": "~4.0.22",
        "expo-splash-screen": "~0.29.24",
        "expo-status-bar": "~2.0.1",
        "expo-symbols": "~0.2.2",
        "expo-system-ui": "~4.0.9",
        "expo-web-browser": "~14.0.2",
        "formik": "^2.4.9",
        "luxon": "^3.7.2",
        "nativewind": "^4.2.6",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-gifted-charts": "^0.0.12",
        "react-native": "0.76.9",
        "react-native-css-interop": "^0.1.22",
        "react-native-gesture-handler": "~2.20.2",
        "react-native-gifted-charts": "^1.4.78",
        "react-native-linear-gradient": "^2.8.3",
        "react-native-mmkv": "^3.3.3",
        "react-native-reanimated": "~3.16.7",
        "react-native-safe-area-context": "4.12.0",
        "react-native-screens": "~4.4.0",
        "react-native-svg": "15.8.0",
        "react-native-toast-message": "2.3.3",
        "react-native-ui-datepicker": "^3.3.0",
        "react-native-web": "~0.19.13",
        "react-native-webview": "13.12.5",
        "tailwind-merge": "3.5.0",
        "tailwindcss": "^3.4.19",
        "tailwindcss-animate": "^1.0.7",
        "yup": "^1.7.1",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@commitlint/cli": "^19.8.1",
        "@commitlint/config-conventional": "^19.8.1",
        "@react-native-community/cli": "^18.0.1",
        "@semantic-release/git": "^10.0.1",
        "@types/babel__core": "~7.20.5",
        "@types/jest": "^29.5.14",
        "@types/jscodeshift": "~17.3.0",
        "@types/luxon": "^3.7.5",
        "@types/node": "^20.19.43",
        "@types/react": "~18.3.31",
        "@types/react-dom": "~18.3.7",
        "@types/react-native-web": "0.19.2",
        "@types/react-test-renderer": "^18.3.1",
        "concurrently": "^9.2.4",
        "jest": "^29.7.0",
        "jest-expo": "~52.0.6",
        "jscodeshift": "^0.15.2",
        "lefthook": "^1.13.6",
        "oxfmt": "^0.67.0",
        "oxlint": "^1.82.0",
        "oxlint-tailwindcss": "^1.10.2",
        "react-test-renderer": "18.3.1",
        "semantic-release": "^24.2.9",
        "typescript": "^5.9.3"
    },
    "overrides": {
        "cookie": "^0.7.0",
        "esbuild": "^0.25.0",
        "send": "^0.19.0"
    },
    "release": {
        "branches": [
            "main"
        ],
        "plugins": [
            "@semantic-release/commit-analyzer",
            "@semantic-release/release-notes-generator",
            "@semantic-release/npm",
            "@semantic-release/git",
            "@semantic-release/github"
        ]
    },
    "jest": {
        "preset": "jest-expo"
    },
    "engines": {
        "node": ">=16.9"
    },
    "expo": {
        "doctor": {
            "reactNativeDirectoryCheck": {
                "listUnknownPackages": false
            }
        }
    }
}
