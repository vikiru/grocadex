{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "target": "ESNext",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "noEmit": true,
        "incremental": true,
        "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo",
        "allowJs": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "strict": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"],
            "tailwind.config": ["./tailwind.config.js"]
        },
        "typeRoots": ["./node_modules/@types", "./src/types", "./src/api/types", "./src/api/node_modules/@types"]
    },
    "include": [
        "src/**/*",
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/app/**/*.ts",
        "nativewind-env.d.ts",
        ".expo/types/**/*.ts",
        "expo-env.d.ts"
    ],
    "exclude": ["node_modules", "dist", ".expo", "src/api"]
}
